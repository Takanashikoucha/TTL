{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TTL Build Configuration",
  "description": "TTL 个性化桌面 Linux 发行版构建配置",
  "type": "object",
  "required": ["distro_name", "base", "desktop", "kernel", "packages", "ai_assistant", "install"],
  "properties": {
    "distro_name": {
      "type": "string",
      "description": "发行版名称（用于 ISO 文件名）",
      "pattern": "^[a-z0-9-]+$"
    },
    "base": {
      "type": "string",
      "description": "基座版本",
      "enum": ["lfs-12.4 + blfs-13.1"]
    },
    "hardware_profile": {
      "type": "object",
      "description": "硬件配置（由 probe.sh 生成）",
      "properties": {
        "os": {"type": "string"},
        "cpu": {"type": "string"},
        "cpu_arch": {"type": "string"},
        "cpu_flags": {"type": "array", "items": {"type": "string"}},
        "cpu_cores": {"type": "integer"},
        "ram_gb": {"type": "number"},
        "disk_type": {"type": "string", "enum": ["ssd", "hdd", "nvme"]},
        "disk_size_gb": {"type": "number"},
        "gpu": {"type": "string"},
        "gpu_driver": {"type": "string", "enum": ["nvidia", "amd", "intel"]},
        "display_resolution": {"type": "string"},
        "installed_software": {"type": "array", "items": {"type": "string"}}
      }
    },
    "desktop": {
      "type": "string",
      "description": "桌面环境",
      "enum": ["xfce", "gnome", "kde", "i3"]
    },
    "desktop_theme": {
      "type": "object",
      "description": "桌面美化配置",
      "properties": {
        "icon_theme": {"type": "string", "enum": ["yaru", "tela", "adwaita"]},
        "cursor_theme": {"type": "string"},
        "wallpaper": {"type": "string", "description": "壁纸 URL 或路径，auto_select 表示自动选择"},
        "fonts": {"type": "array", "items": {"type": "string"}}
      }
    },
    "input_method": {
      "type": "object",
      "description": "输入法配置",
      "properties": {
        "framework": {"type": "string", "enum": ["fcitx5", "ibus"]},
        "im_list": {"type": "array", "items": {"type": "string"}}
      }
    },
    "kernel": {
      "type": "object",
      "description": "内核配置",
      "required": ["version", "hardened"],
      "properties": {
        "version": {"type": "string"},
        "hardened": {"type": "boolean"},
        "cpu_optimizations": {"type": "array", "items": {"type": "string"}},
        "gpu_driver": {"type": "string", "enum": ["nvidia", "amd", "intel"]},
        "power_profile": {"type": "string", "enum": ["performance", "balanced", "powersave"]}
      }
    },
    "packages": {
      "type": "object",
      "description": "软件包配置",
      "properties": {
        "core": {"type": "array", "items": {"type": "string"}},
        "dev": {"type": "array", "items": {"type": "string"}},
        "extra": {"type": "array", "items": {"type": "string"}}
      }
    },
    "windows_compat": {
      "type": "object",
      "description": "Windows 软件兼容配置",
      "properties": {
        "wine_version": {"type": "string"},
        "winapps": {"type": "boolean"},
        "preinstalled_apps": {"type": "array", "items": {"type": "string"}}
      }
    },
    "ai_assistant": {
      "type": "object",
      "description": "AI 助手配置",
      "required": ["model", "quantization", "runtime"],
      "properties": {
        "model": {"type": "string", "enum": ["qwen3.5-9b"]},
        "quantization": {"type": "string", "enum": ["q3_k_m", "q4_k_m", "q5_k_m", "q6_k", "q8_0"]},
        "runtime": {"type": "string", "enum": ["llama.cpp"]},
        "system_prompt": {"type": "string"}
      }
    },
    "install": {
      "type": "object",
      "description": "安装配置",
      "required": ["unattended", "timezone", "locale", "username"],
      "properties": {
        "unattended": {"type": "boolean"},
        "disk_layout": {"type": "string", "enum": ["auto", "lvm", "btrfs"]},
        "timezone": {"type": "string"},
        "locale": {"type": "string"},
        "username": {"type": "string"},
        "encryption": {"type": "boolean"}
      }
    },
    "search_protocol": {
      "type": "object",
      "description": "搜索协议配置",
      "properties": {
        "enabled": {"type": "boolean"},
        "search_sources": {"type": "array", "items": {"type": "string"}},
        "decision_log": {"type": "boolean"}
      }
    }
  }
}
